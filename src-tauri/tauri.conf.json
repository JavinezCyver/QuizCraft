{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuizCraft",
  "version": "1.0.6",
  "identifier": "com.quizcraft.app",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "QuizCraft",
        "width": 1100,
        "height": 800,
        "minWidth": 320,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "android": {
      "minSdkVersion": 24
    }
  }
}

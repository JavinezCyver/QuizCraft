{
  "name": "quizcraft",
  "version": "1.0.11",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev:web",
    "build": "tsc -b && vite build",
    "start": "node scripts/server.mjs",
    "test": "npm run build && npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/questions.test.mjs tests/review.test.mjs tests/question-format.test.mjs tests/answer-highlight.test.mjs tests/quiz-edit.test.mjs",
    "test:e2e": "playwright test",
    "admin": "node scripts/server.mjs admin",
    "dev:api": "node scripts/cargo.mjs run -p quizcraft-server",
    "dev:web": "vite --host 0.0.0.0",
    "build:api": "node scripts/cargo.mjs build --release -p quizcraft-server",
    "migrate": "node scripts/server.mjs migrate",
    "tauri": "node scripts/tauri.mjs",
    "android:init": "node scripts/tauri.mjs android init",
    "android:dev": "node scripts/tauri.mjs android dev",
    "android:build": "node scripts/tauri.mjs android build",
    "android:build:debug": "node scripts/android-debug.mjs",
    "android:build:release": "node scripts/android-build.mjs --release",
    "test:legacy": "node scripts/cargo.mjs test -p quizcraft-server && node scripts/cargo.mjs build -p quizcraft-server && node --test tests/*.test.mjs",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.2.3",
    "@tailwindcss/vite": "^4.1.13",
    "@tauri-apps/api": "^2.12.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tauri-apps/cli": "^2.12.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.10",
    "typescript": "~5.9.2",
    "vite": "^7.1.0"
  }
}
